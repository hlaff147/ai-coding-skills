[
  {
    "v": 2,
    "name": "Fleet Management API",
    "folders": [
      {
        "v": 2,
        "name": "Auth",
        "folders": [],
        "requests": [
          {
            "v": 1,
            "name": "Autenticação (Login)",
            "method": "POST",
            "endpoint": "<<baseUrl>>/api/v1/auth/login",
            "params": [],
            "headers": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "active": true
              }
            ],
            "preRequestScript": "",
            "testScript": "pw.expect(pw.response.status).toBe(200);\nconst data = JSON.parse(pw.response.body);\npw.expect(data.token).toBeDefined();\npw.env.set(\"authToken\", data.token);",
            "auth": {
              "authType": "none",
              "authActive": true
            },
            "body": {
              "contentType": "application/json",
              "body": "{\n  \"username\": \"operator@empresa.com\",\n  \"password\": \"P@ssword123\"\n}"
            }
          }
        ]
      },
      {
        "v": 2,
        "name": "Vehicles",
        "folders": [],
        "requests": [
          {
            "v": 1,
            "name": "Cadastrar Veículo",
            "method": "POST",
            "endpoint": "<<baseUrl>>/api/v1/vehicles",
            "params": [],
            "headers": [
              {
                "key": "Authorization",
                "value": "Bearer <<authToken>>",
                "active": true
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "active": true
              }
            ],
            "preRequestScript": "",
            "testScript": "pw.expect(pw.response.status).toBe(201);\nconst data = JSON.parse(pw.response.body);\npw.expect(data.id).toBeDefined();\npw.env.set(\"vehicleId\", data.id);",
            "auth": {
              "authType": "inherit",
              "authActive": true
            },
            "body": {
              "contentType": "application/json",
              "body": "{\n  \"plate\": \"ABC-1234\",\n  \"model\": \"Scania R450\",\n  \"year\": 2024\n}"
            }
          },
          {
            "v": 1,
            "name": "Consultar Veículo por ID",
            "method": "GET",
            "endpoint": "<<baseUrl>>/api/v1/vehicles/<<vehicleId>>",
            "params": [],
            "headers": [
              {
                "key": "Authorization",
                "value": "Bearer <<authToken>>",
                "active": true
              }
            ],
            "preRequestScript": "",
            "testScript": "pw.expect(pw.response.status).toBe(200);\nconst data = JSON.parse(pw.response.body);\npw.expect(data.id).toBe(pw.env.get(\"vehicleId\"));",
            "auth": {
              "authType": "inherit",
              "authActive": true
            },
            "body": {
              "contentType": null,
              "body": null
            }
          }
        ]
      }
    ],
    "requests": []
  }
]
